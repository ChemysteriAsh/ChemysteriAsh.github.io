{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0 text-center">
      <div class="mb-2">
        <img src="https://hitscounter.dev/api/hit?url=https%3A%2F%2Fchemysteriash.github.io%2F&label=visitors&icon=emoji-smile-fill&color=%23cfe2ff&message=&style=for-the-badge&tz=UTC">
      </div>
      <span style="color: var(--global-text-color); font-size: 1.1rem; font-weight: 500;">
        {{ footer_contents }}
      </span>
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container text-center">
      <div class="mb-2">
        <img src="https://hitscounter.dev/api/hit?url=https%3A%2F%2Fchemysteriash.github.io%2F&label=visitors&icon=emoji-smile-fill&color=%23cfe2ff&message=&style=for-the-badge&tz=UTC">
      </div>
      <span style="color: var(--global-text-color); font-size: 1.1rem; font-weight: 500;">
        {{ footer_contents }}
      </span>
    </div>
  </footer>
{% endif %}
